# Labirinto do Ratinho - Arquivo de Exemplo de Ambiente
# ════════════════════════════════════════════════════════════════
#
# Este arquivo mostra as variáveis de ambiente disponíveis.
# COPIE este arquivo para .env e defina seus próprios valores.
#
# NÃO VERSIONE O ARQUIVO .env (ele está no .gitignore)
#
# Como usar:
#   1. Crie um arquivo chamado ".env" na raiz do projeto
#   2. Copie o conteúdo deste arquivo
#   3. Preencha com seus valores
#   4. A biblioteca python-dotenv carregará automaticamente
#
# ════════════════════════════════════════════════════════════════

# ── CONFIGURAÇÃO DO FLASK ───────────────────────────────────────
# FLASK_ENV: Define o ambiente (development ou production)
FLASK_ENV=development

# FLASK_DEBUG: Ativa modo debug (auto-reload, traceback detalhado)
FLASK_DEBUG=True

# SECRET_KEY: Chave secreta para sessões (gere uma aleatória!)
SECRET_KEY=sua_chave_super_secreta_aqui_mude_isso

# ── CONFIGURAÇÃO DO SERVIDOR ────────────────────────────────────
# FLASK_HOST: Host do servidor (0.0.0.0 para aceitar conexões externas)
FLASK_HOST=127.0.0.1

# FLASK_PORT: Porta do servidor
FLASK_PORT=5000

# ── LOGGING ─────────────────────────────────────────────────────
# LOG_LEVEL: Nível de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ════════════════════════════════════════════════════════════════
